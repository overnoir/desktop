{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Overnoir",
  "version": "0.1.0",
  "identifier": "com.overnoir",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Overnoir Updater",
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "label": "updater",
        "url": "/updater",
        "visible": false,
        "center": true,
        "height": 300,
        "width": 400
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
